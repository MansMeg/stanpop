  structural_bridge_x_drift = data.frame(
    y = "L",
    from_x = 0.025,
    to_x = 0.043
  ),
  structural_bridge_sigma_scale = c(
    M = 1, L = 0.5, C = 1, KD = 1,
    S = 1, V = 1, MP = 1, SD = 1
  )
)}

